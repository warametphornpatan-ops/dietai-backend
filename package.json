{
  "name": "smart-carb-analyzer-backend",
  "version": "1.0.0",
  "description": "Smart Carb Analyzer API Backend",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "pm2:start": "pm2 start ecosystem.config.json --env production",
    "pm2:restart": "pm2 restart ecosystem.config.json",
    "pm2:stop": "pm2 stop ecosystem.config.json",
    "pm2:logs": "pm2 logs smart-carb-api",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "@supabase/supabase-js": "^2.106.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20",
    "prisma": "^7.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
